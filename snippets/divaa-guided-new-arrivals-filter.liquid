{% liquid
  assign filter_categories = 'necklace-sets|Necklace Sets|All Necklace Sets|american-diamond:American Diamond,kundan:Kundan,temple-jewelry:Temple Jewelry,traditional-jewelry:Traditional Jewelry,oxidized-jewelry:Oxidized Jewelry,bridal-necklace-sets:Bridal Necklace Sets,fusion-contemporary:Fusion / Contemporary,premium-collection:Premium Collection||earrings|Earrings|All Earrings|american-diamond-earrings:American Diamond Earrings,kundan-earrings:Kundan Earrings,temple-earrings:Temple Earrings,oxidized-earrings:Oxidized Earrings||bangles-bracelets|Bangles & Bracelets|All Bangles & Bracelets|bangles:Bangles,kadas:Kadas,american-diamond-bangles:American Diamond Bangles,kundan-bangles:Kundan Bangles,temple-bangles:Temple Bangles,oxidized-bangles:Oxidized Bangles||rings|Rings|All Rings|american-diamond-rings:American Diamond Rings,kundan-rings:Kundan Rings||bridal-accessories|Bridal Accessories|All Bridal Accessories|maang-tikka:Maang Tikka,passa:Passa,matha-patti:Matha Patti,hathphool:Hathphool,bajuband:Bajuband,waist-belt-kamarband:Waist Belt / Kamarband||sarees|Sarees|All Sarees|banarasi-sarees:Banarasi Sarees,kanchivaram-sarees:Kanchivaram Sarees,bridal-sarees:Bridal Sarees,designer-sarees:Designer Sarees,party-wear-sarees:Party Wear Sarees||lehengas|Lehengas|All Lehengas|party-wear-lehenga:Party Wear Lehenga||dresses-gowns|Dresses/Gowns|All Dresses/Gowns|indo-western:Indo Western,anarkali:Anarkali,party-wear-dresses:Party Wear Dresses' | split: '||'
%}

<section class="new-arrivals-carbon-filter" data-new-arrivals-filter aria-label="New Arrivals filters">
  <div class="carbon-filter-header">
    <strong>Filter</strong>
    <a href="{{ routes.collections_url }}/new-arrivals" data-clear-all>Clear all</a>
  </div>

  {% for category in filter_categories %}
    {% assign category_parts = category | split: '|' %}
    {% assign category_handle = category_parts[0] %}
    {% assign category_label = category_parts[1] %}
    {% assign category_all_label = category_parts[2] %}
    {% assign subcategory_items = category_parts[3] | split: ',' %}
    {% assign panel_id = 'new-arrivals-' | append: category_handle | append: '-panel' %}
    {% assign trigger_id = 'new-arrivals-' | append: category_handle | append: '-trigger' %}

    <div class="carbon-filter-accordion" data-category-accordion data-type="{{ category_handle }}">
      <button class="carbon-filter-trigger"
              type="button"
              id="{{ trigger_id }}"
              data-carbon-filter-trigger
              data-filter-category-trigger
              data-value="{{ category_handle }}"
              aria-expanded="false"
              aria-controls="{{ panel_id }}">
        <span>{{ category_label }}</span>
        <span class="carbon-filter-chevron" aria-hidden="true"></span>
      </button>

      <div class="carbon-filter-panel" id="{{ panel_id }}" aria-labelledby="{{ trigger_id }}" data-carbon-filter-panel hidden>
        <div class="carbon-option-list" data-subcategory-group data-type="{{ category_handle }}" aria-label="{{ category_label }} choices">
          <a href="{{ routes.collections_url }}/new-arrivals?type={{ category_handle }}"
             class="carbon-option-row"
             role="checkbox"
             aria-checked="false"
             data-filter-subcategory-link
             data-value="">
            <span class="carbon-checkbox" aria-hidden="true"></span>
            <span class="carbon-option-label">{{ category_all_label }}</span>
          </a>

          {% for item in subcategory_items %}
            {% assign item_parts = item | split: ':' %}
            {% assign item_handle = item_parts[0] %}
            {% assign item_label = item_parts[1] %}
            <a href="{{ routes.collections_url }}/new-arrivals?type={{ category_handle }}&subcategory={{ item_handle }}"
               class="carbon-option-row"
               role="checkbox"
               aria-checked="false"
               data-filter-subcategory-link
               data-value="{{ item_handle }}">
              <span class="carbon-checkbox" aria-hidden="true"></span>
              <span class="carbon-option-label">{{ item_label }}</span>
            </a>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endfor %}
</section>
