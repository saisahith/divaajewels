<div class="cart-drawer-backdrop" data-cart-close hidden></div>
<aside class="cart-drawer" id="cart-drawer" aria-label="Cart drawer" aria-hidden="true">
  <div class="cart-drawer-head">
    <strong>Your Cart</strong>
    <button type="button" data-cart-close aria-label="Close cart"><i class="fas fa-times"></i></button>
  </div>

  <div class="cart-drawer-body">
    {% if cart.item_count == 0 %}
      <div class="empty-cart drawer-empty">
        <i class="fas fa-shopping-bag"></i>
        <p>Your cart is empty</p>
        <a href="{{ routes.collections_url }}/necklace-sets" class="btn-primary">Shop Jewelry</a>
      </div>
    {% else %}
      {% for item in cart.items %}
        <div class="drawer-line">
          <a href="{{ item.url }}">
            {% if item.image %}
              <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" loading="lazy" width="80" height="100">
            {% endif %}
          </a>
          <div>
            <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
            {% unless item.variant.title == 'Default Title' %}
              <p>{{ item.variant.title }}</p>
            {% endunless %}
            <p>Qty: {{ item.quantity }}</p>
          </div>
          <strong>{{ item.line_price | money }}</strong>
        </div>
      {% endfor %}
    {% endif %}
  </div>

  <div class="cart-drawer-foot">
    <div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
    <a href="{{ routes.cart_url }}" class="btn-outline">View Cart</a>
    <a href="/checkout" class="btn-primary">Checkout</a>
    <a href="{{ routes.collections_url }}/necklace-sets" class="drawer-continue">Continue shopping</a>
  </div>
</aside>
