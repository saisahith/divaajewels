{% liquid
  assign product_type_handles = 'necklace-sets,earrings,bangles-bracelets,rings,bridal-accessories,sarees,lehengas,dresses-gowns' | split: ','
  assign subcategory_handles = 'american-diamond,kundan,temple-jewelry,traditional-jewelry,oxidized-jewelry,bridal-necklace-sets,fusion-contemporary,premium-collection,american-diamond-earrings,kundan-earrings,temple-earrings,oxidized-earrings,bangles,kadas,american-diamond-bangles,kundan-bangles,temple-bangles,oxidized-bangles,american-diamond-rings,kundan-rings,maang-tikka,passa,matha-patti,hathphool,bajuband,waist-belt-kamarband,banarasi-sarees,kanchivaram-sarees,bridal-sarees,designer-sarees,party-wear-sarees,party-wear-lehenga,indo-western,anarkali,party-wear-dresses' | split: ','
  assign bridal_category_handles = 'bridal-necklace-sets,maang-tikka,passa,matha-patti,hathphool,bajuband,waist-belt-kamarband,bridal-sarees' | split: ','
  assign product_type_data = ''
  assign subcategory_data = ''
  assign bridal_category_data = ''

  for product_collection in product.collections
    if product_type_handles contains product_collection.handle
      assign product_type_data = product_type_data | append: product_collection.handle | append: ','
    endif
    if subcategory_handles contains product_collection.handle
      assign subcategory_data = subcategory_data | append: product_collection.handle | append: ','
    endif
    if bridal_category_handles contains product_collection.handle
      assign bridal_category_data = bridal_category_data | append: product_collection.handle | append: ','
    endif
  endfor

  for tag in product.tags
    assign tag_handle = tag | handleize
    assign normalized_tag_handle = tag_handle
    case tag_handle
      when 'clothing-type-banarasi-sarees', 'saree-banarasi'
        assign normalized_tag_handle = 'banarasi-sarees'
      when 'clothing-type-kanchivaram-sarees'
        assign normalized_tag_handle = 'kanchivaram-sarees'
      when 'clothing-type-bridal-sarees'
        assign normalized_tag_handle = 'bridal-sarees'
      when 'clothing-type-designer-sarees'
        assign normalized_tag_handle = 'designer-sarees'
      when 'clothing-type-party-wear-sarees'
        assign normalized_tag_handle = 'party-wear-sarees'
      when 'clothing-type-party-wear-lehenga'
        assign normalized_tag_handle = 'party-wear-lehenga'
    endcase
    if product_type_handles contains normalized_tag_handle
      assign product_type_data = product_type_data | append: normalized_tag_handle | append: ','
    endif
    if subcategory_handles contains normalized_tag_handle
      assign subcategory_data = subcategory_data | append: normalized_tag_handle | append: ','
    endif
    if bridal_category_handles contains normalized_tag_handle
      assign bridal_category_data = bridal_category_data | append: normalized_tag_handle | append: ','
    endif
  endfor

  assign product_type_data = product_type_data | split: ',' | uniq | join: ','
  assign subcategory_data = subcategory_data | split: ',' | uniq | join: ','
  assign bridal_category_data = bridal_category_data | split: ',' | uniq | join: ','
%}

<div class="product-card" data-product-card{% if product_type_data != blank %} data-product-type="{{ product_type_data }}"{% endif %}{% if subcategory_data != blank %} data-subcategory="{{ subcategory_data }}"{% endif %}{% if bridal_category_data != blank %} data-bridal-category="{{ bridal_category_data }}"{% endif %}>
  <div class="product-img-wrap">
    <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
      {% if product.featured_image %}
        <img src="{{ product.featured_image | image_url: width: 600 }}"
             alt="{{ product.featured_image.alt | escape }}"
             loading="lazy" width="600" height="800">
        {% if product.images.size > 1 %}
          <img class="product-card-second-image"
               src="{{ product.images[1] | image_url: width: 600 }}"
               alt="{{ product.images[1].alt | default: product.title | escape }}"
               loading="lazy" width="600" height="800">
        {% endif %}
      {% else %}
        <div class="product-placeholder">
          <i class="fas fa-gem"></i>
          <span>{{ product.type | default: 'Jewellery' }}</span>
        </div>
      {% endif %}
    </a>

    <div class="product-overlay">
      <a href="{{ product.url }}" class="quick-view-link" aria-label="Quick view {{ product.title | escape }}">Quick View</a>
      <button class="quick-add"
              type="button"
              data-variant-id="{{ product.first_available_variant.id }}"
              {% unless product.available %}disabled{% endunless %}>
        {% if product.available %}Add to Cart{% else %}Sold Out{% endif %}
      </button>
    </div>

    {% unless product.available %}
      <span class="product-badge badge-sold">Sold Out</span>
    {% else %}
      {% if product.compare_at_price > product.price %}
        <span class="product-badge">Sale</span>
      {% elsif product.tags contains 'new-arrival' or product.tags contains 'new' %}
        <span class="product-badge">New Arrival</span>
      {% elsif product.tags contains 'bestseller' or product.tags contains 'best-seller' %}
        <span class="product-badge">Bestseller</span>
      {% endif %}
    {% endunless %}
  </div>

  <div class="product-info">
    <p class="product-brand">{{ product.vendor }}</p>
    <h3 class="product-name">
      <a href="{{ product.url }}" style="color:inherit;">{{ product.title }}</a>
    </h3>
    <p class="product-price {% unless product.available %}sold{% endunless %}">
      {% if product.compare_at_price > product.price %}
        <s style="color:var(--gray); font-size:12px;">{{ product.compare_at_price | money }}</s>
        &nbsp;
        {% assign discount_amount = product.compare_at_price | minus: product.price %}
        {% assign discount_percent = discount_amount | times: 100 | divided_by: product.compare_at_price %}
        <span class="product-discount">{{ discount_percent }}% off</span>
        &nbsp;
      {% endif %}
      {{ product.price | money }}
    </p>
  </div>
</div>
