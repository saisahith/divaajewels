{% liquid
  assign filter_context = filter_context | default: 'clothing'
  assign current_handle = current_handle | default: collection.handle
  assign selected_clothing_type = selected_clothing_type | default: ''

  assign base_handle = current_handle
  assign all_label = 'All'
  assign option_items = ''

  if filter_context == 'clothing'
    if selected_clothing_type == 'lehengas'
      assign base_handle = 'lehengas'
      assign all_label = 'All Lehengas'
      assign option_items = 'party-wear-lehenga|Party Wear Lehenga'
    elsif selected_clothing_type == 'dresses-gowns'
      assign base_handle = 'dresses-gowns'
      assign all_label = 'All Dresses/Gowns'
      assign option_items = 'indo-western|Indo Western,anarkali|Anarkali,party-wear-dresses|Party Wear Dresses'
    else
      assign base_handle = 'sarees'
      assign all_label = 'All Sarees'
      assign option_items = 'banarasi-sarees|Banarasi Sarees,kanchivaram-sarees|Kanchivaram Sarees,bridal-sarees|Bridal Sarees,designer-sarees|Designer Sarees,party-wear-sarees|Party Wear Sarees'
    endif
  endif

  assign panel_id = 'clothing-type-panel-' | append: current_handle
  assign trigger_id = 'clothing-type-trigger-' | append: current_handle
  assign option_rows = option_items | split: ','
  assign base_path = routes.collections_url | append: '/' | append: base_handle
%}

<section class="divaa-carbon-filter clothing-carbon-filter"
         data-clothing-filter
         data-clothing-base-path="{{ base_path }}"
         data-clothing-product-type="{{ selected_clothing_type }}"
         aria-label="Clothing collection filters">
  <div class="carbon-filter-header">
    <strong>Filter</strong>
    <a href="{{ base_path }}" data-clothing-clear-all>Clear all</a>
  </div>

  <div class="carbon-filter-accordion active" data-clothing-filter-accordion>
    <button class="carbon-filter-trigger"
            type="button"
            id="{{ trigger_id }}"
            data-carbon-filter-trigger
            aria-expanded="true"
            aria-controls="{{ panel_id }}">
      <span>Clothing Type</span>
      <span class="carbon-filter-chevron" aria-hidden="true"></span>
    </button>

    <div class="carbon-filter-panel" id="{{ panel_id }}" aria-labelledby="{{ trigger_id }}" data-carbon-filter-panel>
      <div class="carbon-option-list" aria-label="Clothing type choices">
        <a href="{{ base_path }}"
           class="carbon-option-row"
           role="checkbox"
           aria-checked="true"
           data-clothing-filter-option
           data-value="">
          <span class="carbon-checkbox" aria-hidden="true"></span>
          <span class="carbon-option-label">{{ all_label }}</span>
        </a>

        {% for item in option_rows %}
          {% assign item_parts = item | split: '|' %}
          {% assign item_handle = item_parts[0] %}
          {% assign item_label = item_parts[1] %}
          <a href="{{ base_path }}?clothing_type={{ item_handle }}"
             class="carbon-option-row"
             role="checkbox"
             aria-checked="false"
             data-clothing-filter-option
             data-value="{{ item_handle }}">
            <span class="carbon-checkbox" aria-hidden="true"></span>
            <span class="carbon-option-label">{{ item_label }}</span>
          </a>
        {% endfor %}
      </div>
    </div>
  </div>
</section>
