<section class="shop-look">
  <div class="shop-look-inner">
    <div class="look-image">
      <div class="look-rings">
        <div class="look-ring"></div>
        <div class="look-ring"></div>
        <div class="look-ring"></div>
      </div>
      <div class="look-image-placeholder glass-panel">
        <i class="fas fa-gem"></i>
        <p>Jewelry With Sarees</p>
      </div>
    </div>
    <div class="look-content">
      <div class="look-content-inner">
        <span class="section-label">{{ section.settings.label }}</span>
        <h2 class="look-title">{{ section.settings.title }}</h2>
        <div class="section-divider"></div>
        <p class="look-desc">{{ section.settings.description }}</p>
        {% assign shop_look_url = routes.collections_url | append: '/bridal-jewelry' %}
        <a href="{{ section.settings.cta_url | default: shop_look_url }}" class="btn-primary">
          {{ section.settings.cta_label }} &nbsp;<i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop The Look",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Styled For You" },
    { "type": "text", "id": "title", "label": "Title", "default": "Pair Jewelry With Every Saree" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Build a complete ethnic look with statement necklaces, earrings, bangles, and tikka sets designed to complement sarees." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Bridal Jewelry" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Shop The Look" }]
}
{% endschema %}
