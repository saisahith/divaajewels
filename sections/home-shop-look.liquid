<section class="shop-look">
  <div class="shop-look-inner">
    <div class="look-image">
      <div class="look-rings">
        <div class="look-ring"></div>
        <div class="look-ring"></div>
        <div class="look-ring"></div>
      </div>
      <div class="look-image-placeholder">
        <i class="fas fa-gem"></i>
        <p>Curated Look</p>
      </div>
    </div>
    <div class="look-content">
      <div class="look-content-inner">
        <span class="section-label">{{ section.settings.label }}</span>
        <h2 class="look-title">{{ section.settings.title }}</h2>
        <div class="section-divider"></div>
        <p class="look-desc">{{ section.settings.description }}</p>
        <a href="{{ section.settings.cta_url }}" class="btn-primary">
          {{ section.settings.cta_label }} &nbsp;<i class="fas fa-arrow-right"></i>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop The Look",
  "settings": [
    { "type": "text", "id": "label",       "label": "Label",       "default": "Styled For You" },
    { "type": "text", "id": "title",       "label": "Title",       "default": "Shop The Complete Look" },
    { "type": "textarea", "id": "description", "label": "Description",
      "default": "From statement necklaces to matching earrings, bangles, and maang tikka — discover curated sets that tell a story of elegance." },
    { "type": "text", "id": "cta_label",   "label": "Button label","default": "Shop All Jewellery" },
    { "type": "url",  "id": "cta_url",     "label": "Button link" }
  ],
  "presets": [{ "name": "Shop The Look" }]
}
{% endschema %}
