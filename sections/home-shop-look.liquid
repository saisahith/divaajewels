<section class="shop-look tsr-promo">
  <div class="shop-look-inner">
    <div class="look-content tsr-promo-copy">
      <div class="look-content-inner">
        <span class="section-label">{{ section.settings.label }}</span>
        <h2 class="look-title">{{ section.settings.title }}</h2>
        <p class="look-desc">{{ section.settings.description }}</p>
        {% assign promo_url = routes.collections_url | append: '/all' %}
        <a href="{{ section.settings.cta_url | default: promo_url }}" class="btn-primary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    </div>
    <div class="look-image tsr-promo-image" style="background-image:url('{{ 'divaa-saree-edits.png' | asset_url }}');"></div>
  </div>
</section>

{% schema %}
{
  "name": "Shop The Look",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Pair Jewelry With Sarees" },
    { "type": "text", "id": "title", "label": "Title", "default": "Complete the ethnic look." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Match statement jewelry with sarees for weddings, festive wear, pooja events, and party-ready styling." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Pairings" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Shop The Look" }]
}
{% endschema %}
