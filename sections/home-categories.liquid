<section class="categories product-type-section">
  <div class="container">
    <div class="categories-header">
      <span class="section-label">Shop By Product Type</span>
      <h2 class="section-title">Start with the piece.</h2>
    </div>

    <div class="categories-grid">
      {% assign cards = "Necklace Sets|necklace-sets|0% 0%,Bridal Necklace Sets|bridal-necklace-sets|50% 0%,Earrings|earrings|100% 0%,Bangles & Bracelets|bangles-bracelets|0% 100%,Rings|rings|50% 100%,Sarees|sarees|100% 100%" | split: "," %}
      {% for item in cards %}
        {% assign card = item | split: "|" %}
        <a href="{{ routes.collections_url }}/{{ card[1] }}" class="category-card">
          <div class="category-bg category-img" style="background-image:url('{% if forloop.index == 6 %}{{ 'divaa-saree-edits.png' | asset_url }}{% else %}{{ 'divaa-jewelry-types.png' | asset_url }}{% endif %}'); background-position:{{ card[2] }};"></div>
          <div class="category-overlay">
            <h3 class="category-name">{{ card[0] }}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop By Product Type",
  "settings": [],
  "presets": [{ "name": "Shop By Product Type" }]
}
{% endschema %}
