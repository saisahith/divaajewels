        <div class="category-bg" style="background:linear-gradient(135deg,#20171c,#7b4a62,#c990a6);"></div>
        <div class="category-overlay">
          <i class="fas fa-star cat-icon"></i>
          <span class="category-label">Jhumkas · Drops</span>
          <h3 class="category-name">Earrings</h3>
          <span class="category-link">Explore <i class="fas fa-arrow-right"></i></span>
