        <div class="category-bg" style="background:linear-gradient(135deg,#2b1b12,#8b6b2f,#d6b45f);"></div>
        <div class="category-overlay">
          <i class="fas fa-ring cat-icon"></i>
          <span class="category-label">Chokers · Harams</span>
          <h3 class="category-name">Necklace Sets</h3>
          <span class="category-link">Explore <i class="fas fa-arrow-right"></i></span>
