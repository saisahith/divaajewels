<section class="gift-guide tsr-promo tsr-promo-alt">
  <div class="shop-look-inner">
    <div class="look-image tsr-promo-image" style="background-image:url('{{ 'divaa-product-grid.png' | asset_url }}');"></div>
    <div class="look-content tsr-promo-copy">
      <div class="look-content-inner">
        <span class="section-label">Statement Edit</span>
        <h2 class="look-title">{{ section.settings.title }}</h2>
        <p class="look-desc">{{ section.settings.description }}</p>
        {% assign statement_url = routes.collections_url | append: '/american-diamond' %}
        <a href="{{ section.settings.cta_url | default: statement_url }}" class="btn-primary">
          {{ section.settings.cta_label }}
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Statement Promo",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Your statement jewelry is calling." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Traditional, Oxidized, South Indian, American Diamond, and Kundan pieces selected to complete the look." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Get My Statement Piece" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Statement Promo" }]
}
{% endschema %}
