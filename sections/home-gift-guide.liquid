<section class="gift-guide">
  <div class="container">
    <div class="gift-guide-inner">
      <div class="gift-badge glass-panel">
        <span class="gift-badge-title">Gift<br>Edit</span>
        <span class="gift-badge-sub">Jewelry</span>
      </div>
      <div class="gift-content">
        <span class="section-label">Perfect For Every Occasion</span>
        <h2 class="section-title">{{ section.settings.title }}</h2>
        <div class="section-divider"></div>
        <p class="gift-desc">{{ section.settings.description }}</p>
        {% assign gift_url = routes.collections_url | append: '/gift-edit' %}
        <a href="{{ section.settings.cta_url | default: gift_url }}" class="btn-primary">
          {{ section.settings.cta_label }} &nbsp;<i class="fas fa-gift"></i>
        </a>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Gift Guide",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Gifts That Feel Personal" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Weddings, festivals, birthdays, anniversaries, or just because — gift-ready jewelry and saree pairings for meaningful moments." },
    { "type": "text", "id": "cta_label", "label": "Button label", "default": "Shop Gift Edit" },
    { "type": "url", "id": "cta_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Gift Guide" }]
}
{% endschema %}
