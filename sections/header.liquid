            <span>Bridal Collection</span>
            <strong>Statement pieces for every celebration</strong>
            <em>Explore Bridal</em>
          </a>
        </div>
      </div>

      <div class="nav-group">
        <a href="{{ routes.collections_url }}/bridal">Bridal</a>
        <div class="mega-panel mega-bridal-grid">
          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/bridal" class="mega-heading-link">Bridal Collection</a>
            <a href="{{ routes.collections_url }}/bridal-necklace-sets">Bridal Necklace Sets</a>
            <a href="{{ routes.collections_url }}/maang-tikka">Maang Tikka</a>
            <a href="{{ routes.collections_url }}/passa">Passa</a>
