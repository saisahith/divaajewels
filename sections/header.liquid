          </div>

          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/earrings" class="mega-heading-link">Earrings</a>
            <a href="{{ routes.collections_url }}/american-diamond-earrings">American Diamond Earrings</a>
            <a href="{{ routes.collections_url }}/kundan-earrings">Kundan Earrings</a>
            <a href="{{ routes.collections_url }}/temple-earrings">Temple Earrings</a>
            <a href="{{ routes.collections_url }}/oxidized-earrings">Oxidized Earrings</a>
          </div>

          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/bangles-bracelets" class="mega-heading-link">Bangles & Bracelets</a>
            <a href="{{ routes.collections_url }}/bangles">Bangles</a>
            <a href="{{ routes.collections_url }}/kadas">Kadas</a>
            <a href="{{ routes.collections_url }}/american-diamond-bangles">American Diamond Bangles</a>
            <a href="{{ routes.collections_url }}/kundan-bangles">Kundan Bangles</a>
            <a href="{{ routes.collections_url }}/temple-bangles">Temple Bangles</a>
            <a href="{{ routes.collections_url }}/oxidized-bangles">Oxidized Bangles</a>
          </div>

          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/rings" class="mega-heading-link">Rings</a>
            <a href="{{ routes.collections_url }}/american-diamond-rings">American Diamond Rings</a>
            <a href="{{ routes.collections_url }}/kundan-rings">Kundan Rings</a>
          </div>

          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/bridal-accessories" class="mega-heading-link">Bridal Accessories</a>
            <a href="{{ routes.collections_url }}/maang-tikka">Maang Tikka</a>
            <a href="{{ routes.collections_url }}/passa">Passa</a>
            <a href="{{ routes.collections_url }}/matha-patti">Matha Patti</a>
