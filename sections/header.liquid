<header id="header">
  <div class="header-inner">
    <button class="hamburger" id="hamburger" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-nav">
      <span></span><span></span><span></span>
    </button>

    <a href="{{ routes.root_url }}" class="logo" aria-label="{{ shop.name }}">DIVAA</a>

    <nav id="main-nav" aria-label="Primary navigation">
      <a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a>

      <div class="nav-group nav-group-wide">
        <a href="{{ routes.collections_url }}/necklace-sets">Jewelry</a>
        <div class="mega-panel mega-panel-style-grid mega-with-promo">
          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/necklace-sets" class="mega-heading-link">Necklace Sets</a>
            <a href="{{ routes.collections_url }}/american-diamond-necklace-sets">American Diamond</a>
            <a href="{{ routes.collections_url }}/kundan-necklace-sets">Kundan</a>
            <a href="{{ routes.collections_url }}/temple-jewelry-necklace-sets">Temple Jewelry</a>
            <a href="{{ routes.collections_url }}/traditional-necklace-sets">Traditional Jewelry</a>
            <a href="{{ routes.collections_url }}/oxidized-necklace-sets">Oxidized Jewelry</a>
            <a href="{{ routes.collections_url }}/bridal-necklace-sets">Bridal Necklace Sets</a>
            <a href="{{ routes.collections_url }}/fusion-contemporary-necklace-sets">Fusion / Contemporary</a>
