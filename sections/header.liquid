            <a href="{{ routes.collections_url }}/bridal-sarees">Bridal Sarees</a>
          </div>
        </div>
      </div>

      <div class="nav-group">
        <a href="{{ routes.collections_url }}/clothing">Clothing</a>
        <div class="mega-panel mega-clothing-grid">
          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/sarees" class="mega-heading-link">Sarees</a>
            <a href="{{ routes.collections_url }}/banarasi-sarees">Banarasi Sarees</a>
            <a href="{{ routes.collections_url }}/kanchivaram-sarees">Kanchivaram Sarees</a>
            <a href="{{ routes.collections_url }}/bridal-sarees">Bridal Sarees</a>
            <a href="{{ routes.collections_url }}/designer-sarees">Designer Sarees</a>
            <a href="{{ routes.collections_url }}/party-wear-sarees">Party Wear Sarees</a>
          </div>
          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/lehengas" class="mega-heading-link">Lehengas</a>
            <a href="{{ routes.collections_url }}/party-wear-lehenga">Party Wear Lehenga</a>
          </div>
          <div class="mega-style-column">
            <a href="{{ routes.collections_url }}/dresses-gowns" class="mega-heading-link">Dresses / Gowns</a>
            <a href="{{ routes.collections_url }}/indo-western">Indo Western</a>
            <a href="{{ routes.collections_url }}/anarkali">Anarkali</a>
            <a href="{{ routes.collections_url }}/party-wear-dresses">Party Wear Dresses</a>
          </div>
          <a href="{{ routes.collections_url }}/clothing" class="mega-promo-card clothing-promo">
            <span>Shop Ethnic Clothing</span>
            <strong>Sarees, lehengas, and occasion-ready looks</strong>
            <em>Shop Clothing</em>
          </a>
        </div>
      </div>

      <a href="{{ routes.collections_url }}/sale">Sale</a>
      <a href="{{ routes.collections_url }}/clearance">Clearance</a>
      <a href="{{ routes.root_url }}#vip-signup">Membership</a>
    </nav>

    <div class="header-icons">
      <a href="{{ routes.search_url }}" aria-label="Search" id="search-toggle">
        <i class="fas fa-search"></i>
      </a>
      {% if shop.customer_accounts_enabled %}
        <a href="{{ routes.account_url }}" aria-label="Account">
          <i class="fas fa-user"></i>
        </a>
      {% endif %}
      <a href="{{ routes.cart_url }}" aria-label="Cart" class="js-cart-toggle" style="position:relative">
        <i class="fas fa-shopping-bag"></i>
        <span class="cart-badge" id="cart-count">{{ cart.item_count }}</span>
      </a>
    </div>
  </div>
</header>

