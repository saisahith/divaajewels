<section class="categories shop-clothing-section" id="shop-clothing">
  <div class="container">
    <div class="categories-header">
      <span class="section-label">Shop Clothing</span>
      <h2 class="section-title">Ethnic clothing for the full look.</h2>
    </div>

    <div class="clothing-edit-grid">
      {% assign clothing = "Sarees|sarees|Banarasi, Kanchivaram, Bridal, Designer, and Party Wear Sarees|0% 0%||Lehengas|lehengas|Party Wear Lehenga|50% 0%||Dresses / Gowns|dresses-gowns|Indo Western, Anarkali, and Party Wear Dresses|100% 0%" | split: "||" %}
      {% for item in clothing %}
        {% assign card = item | split: "|" %}
        <a href="{{ routes.collections_url }}/{{ card[1] }}" class="clothing-edit-card">
          <div class="clothing-edit-media">
            <div class="clothing-edit-image" style="background-image:url('{{ 'divaa-saree-edits.png' | asset_url }}'); background-position:{{ card[3] }};"></div>
          </div>
          <div class="clothing-edit-copy">
            <span>Explore Clothing</span>
            <h3>{{ card[0] }}</h3>
            <p>{{ card[2] }}</p>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop Clothing",
  "settings": [],
  "presets": [{ "name": "Shop Clothing" }]
}
{% endschema %}
