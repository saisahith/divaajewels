        </p>
        <div class="footer-socials">
          <a href="https://instagram.com/{{ settings.social_instagram | default: 'divaajewels_n_ensemble' }}" target="_blank" rel="noopener" aria-label="Instagram">
            <i class="fab fa-instagram"></i>
