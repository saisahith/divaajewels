<footer>
  <div class="footer-inner">
    <div class="footer-newsletter">
      <div>
        <h2>Stay in the Divaa Circle</h2>
        <p>Sign up for new arrivals, private offers, and styling updates.</p>
      </div>
      <div class="newsletter-form footer-signup">
        <input type="email" class="newsletter-input" placeholder="Email address" aria-label="Email address">
        <button class="newsletter-btn" type="button">Sign Up</button>
      </div>
    </div>

    <div class="footer-top">
      <div class="footer-brand">
        <a href="{{ routes.root_url }}" class="logo">DIVAA</a>
        <p class="footer-desc">
          Premium Indian jewelry and ethnic clothing curated for weddings, festive events, and elevated everyday styling.
          Based in Virginia and shipping across the USA.
        </p>
      </div>

      <div class="footer-col">
        <h4>Customer Care</h4>
        <ul>
          <li><a href="{{ routes.root_url }}pages/contact">Contact Us</a></li>
          <li><a href="{{ routes.root_url }}pages/policies#shipping">Shipping Policy</a></li>
          <li><a href="{{ routes.root_url }}pages/policies#returns">Returns & Exchanges</a></li>
          <li><a href="{{ routes.root_url }}pages/policies#terms">Terms & Conditions</a></li>
          <li><a href="{{ routes.root_url }}pages/policies#privacy">Privacy Policy</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Shop</h4>
        <ul>
          <li><a href="{{ routes.collections_url }}/necklace-sets">Jewelry</a></li>
          <li><a href="{{ routes.collections_url }}/clothing">Clothing</a></li>
          <li><a href="{{ routes.collections_url }}/sale">Sale</a></li>
          <li><a href="{{ routes.collections_url }}/clearance">Clearance</a></li>
          <li><a href="{{ routes.collections_url }}/new-arrivals">New Arrivals</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Divaa Jewels</h4>
        <ul>
          <li><a href="{{ routes.root_url }}pages/about">About Us</a></li>
          <li><a href="{{ routes.root_url }}#vip-signup">Membership</a></li>
          <li><a href="{{ routes.collections_url }}/bridal-accessories">Bridal Collection</a></li>
        </ul>
      </div>

      <div class="footer-col">
        <h4>Connect</h4>
        <ul>
          <li><a href="https://instagram.com/{{ settings.social_instagram | default: 'divaajewels_n_ensemble' }}" target="_blank" rel="noopener">Instagram</a></li>
          <li><a href="https://www.facebook.com/DiVaaJewelsbyNehaJain/" target="_blank" rel="noopener">Facebook</a></li>
          <li><a href="https://wa.me/{{ settings.social_whatsapp | default: '17033894519' }}" target="_blank" rel="noopener">WhatsApp</a></li>
          <li><a href="mailto:divaajewels@gmail.com">Email</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copy">
        &copy; {{ 'now' | date: '%Y' }} <a href="{{ routes.root_url }}">{{ shop.name }}</a>. All rights reserved.
      </p>
      <p class="powered">Virginia, USA / Est. 2020</p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [],
  "presets": [
    { "name": "Footer" }
  ]
}
{% endschema %}
