<section class="cart-page">
  <div class="container">
    <div class="cart-layout">
      <div>
        <span class="section-label">Your Selections</span>
        <h1 class="section-title">Shopping Cart</h1>
      </div>

      {% if cart.item_count == 0 %}
        <div class="empty-cart">
          <i class="fas fa-shopping-bag"></i>
          <p>Your cart is empty</p>
          <a href="{{ routes.collections_url }}/necklace-sets" class="btn-primary">Continue Shopping</a>
        </div>
      {% else %}
        {% form 'cart', cart %}
          <div class="cart-items">
            {% for item in cart.items %}
              <div class="cart-line">
                <a href="{{ item.url }}" class="cart-line-img">
                  {% if item.image %}
                    <img src="{{ item.image | image_url: width: 220 }}" alt="{{ item.image.alt | default: item.product.title | escape }}" loading="lazy" width="110" height="140">
                  {% else %}
                    <i class="fas fa-gem"></i>
                  {% endif %}
                </a>
                <div class="cart-line-info">
                  <h3><a href="{{ item.url }}">{{ item.product.title }}</a></h3>
                  {% unless item.variant.title == 'Default Title' %}
                    <p>{{ item.variant.title }}</p>
                  {% endunless %}
                  <div class="quantity-control cart-qty">
                    <button type="button" data-line-qty-minus aria-label="Decrease quantity">-</button>
                    <input type="number" name="updates[]" value="{{ item.quantity }}" min="0" onchange="this.form.submit()">
                    <button type="button" data-line-qty-plus aria-label="Increase quantity">+</button>
                  </div>
                </div>
                <div class="cart-line-total">
                  <p>{{ item.line_price | money }}</p>
                  <a href="{{ routes.cart_change_url }}?line={{ forloop.index }}&quantity=0">Remove</a>
                </div>
              </div>
            {% endfor %}
          </div>

          <div class="cart-note">
            <label for="CartNote">Order Note (optional)</label>
            <textarea id="CartNote" name="note" rows="3" placeholder="Gift message or special instructions...">{{ cart.note }}</textarea>
          </div>

          <div class="cart-summary">
            <div><span>Subtotal</span><strong>{{ cart.total_price | money }}</strong></div>
            <p>Taxes and shipping calculated at checkout.</p>
            <button type="submit" name="checkout" class="btn-primary">
              <i class="fas fa-lock"></i> Checkout
            </button>
            <a href="{{ routes.collections_url }}/necklace-sets" class="btn-ghost">Continue Shopping</a>
          </div>
        {% endform %}
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cart",
  "settings": [],
  "presets": [{ "name": "Cart" }]
}
{% endschema %}
