<section class="essential-jewelry">
  <div class="container">
    <div class="essential-header">
      <span class="section-label">Essential Jewelry</span>
      <h2 class="section-title">The finishing touch for every outfit.</h2>
    </div>

    <div class="essential-tabs" aria-label="Essential jewelry collections">
      <a href="{{ routes.collections_url }}/kundan-necklace-sets">Kundan</a>
      <a href="{{ routes.collections_url }}/american-diamond-necklace-sets">American Diamond</a>
      <a href="{{ routes.collections_url }}/temple-jewelry-necklace-sets">Temple Jewelry</a>
    </div>

    <div class="essential-products">
      {% assign essentials = "Champagne Kundan Necklace Set|$89|kundan-necklace-sets,American Diamond Necklace Set|$104|american-diamond-necklace-sets,Temple Jewelry Necklace Set|$118|temple-jewelry-necklace-sets,Oxidized Earrings|$45|oxidized-earrings,Traditional Festive Set|$98|traditional-necklace-sets,Silk Saree Pairing|$135|sarees" | split: "," %}
      {% for item in essentials %}
        {% assign p = item | split: "|" %}
        <article class="tsr-product-card">
          <a href="{{ routes.collections_url }}/{{ p[2] }}">
            <div class="tsr-product-media" style="background-image:url('{% if forloop.index <= 5 %}{{ 'divaa-jewelry-styles.png' | asset_url }}{% else %}{{ 'divaa-saree-edits.png' | asset_url }}{% endif %}'); background-position:{% cycle '0% 0%', '50% 0%', '100% 0%', '0% 100%', '50% 100%', '100% 100%' %};">
              <span>Quick View</span>
            </div>
            <h3>{{ p[0] }}</h3>
            <p>{{ p[1] }} USD</p>
          </a>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Essential Jewelry",
  "settings": [],
  "presets": [{ "name": "Essential Jewelry" }]
}
{% endschema %}
