<section class="sale-clearance-section">
  <div class="container">
    <div class="sale-clearance-header">
      <span class="section-label">Live Sale Collection</span>
      <h2 class="section-title">Live deals and final pieces.</h2>
    </div>
    <div class="sale-clearance-grid">
      {% assign cards = "Live Sale|live-sale|0% 0%,Jewelry Sale|jewelry-sale|50% 0%,Saree Sale|saree-sale|100% 0%,Bridal Sale|bridal-sale|0% 100%,Final Pieces|final-pieces|50% 100%,Clearance|clearance|100% 100%" | split: "," %}
      {% for item in cards %}
        {% assign card = item | split: "|" %}
        <a href="{{ routes.collections_url }}/{{ card[1] }}" class="sale-card">
          <div class="sale-card-img" style="background-image:url('{{ 'divaa-saree-edits.png' | asset_url }}'); background-position:{{ card[2] }};"></div>
          <span>{{ card[0] }}</span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Live Sale Collection",
  "settings": [],
  "presets": [{ "name": "Live Sale Collection" }]
}
{% endschema %}
