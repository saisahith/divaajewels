<section class="featured">
  <div class="container">
    <div class="featured-header">
      <span class="section-label">{{ section.settings.label }}</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <div class="section-divider"></div>
    </div>

    <div class="products-grid">
      {%- liquid
        assign col = section.settings.collection
        assign featured_collection = collections[col]
        if featured_collection == blank or featured_collection == nil
          assign featured_collection = collections['american-diamond']
        endif
        assign rendered_products = 0
      -%}

      {%- if featured_collection != blank and featured_collection != nil -%}
        {%- for product in featured_collection.products limit: section.settings.products_count -%}
          {% assign rendered_products = rendered_products | plus: 1 %}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}

      {%- if rendered_products == 0 -%}
        {% assign dummy_products = "American Diamond Necklace Set|$89|New|american-diamond,Kundan Choker Set|$125|Low Stock|kundan,South Indian Temple Necklace|$145|New|south-indian,Oxidized Jhumka Earrings|$42|Best Seller|oxidized,Gold Finish Bangles Set|$58|New|bangles-bracelets,Traditional Silk Saree|$135|Limited|sarees" | split: "," %}
        {% for item in dummy_products %}
          {% assign p = item | split: "|" %}
          <article class="product-card dummy-product-card glass-card">
            <a href="{{ routes.collections_url }}/{{ p[3] }}">
              <div class="product-img-wrap">
                <div class="product-placeholder">
                  <i class="fas fa-gem"></i>
                  <span>{{ p[3] | replace: "-", " " }}</span>
                </div>
                <span class="product-badge">{{ p[2] }}</span>
              </div>
            </a>
            <div class="product-info">
              <p class="product-brand">Divaa Jewels</p>
              <h3 class="product-name"><a href="{{ routes.collections_url }}/{{ p[3] }}" style="color:inherit;">{{ p[0] }}</a></h3>
              <p class="product-price">{{ p[1] }}</p>
            </div>
          </article>
        {% endfor %}
      {%- endif -%}
    </div>

    <div class="view-all-wrap">
      {% assign fallback_url = routes.collections_url | append: '/all' %}
      {% assign col_url = featured_collection.url | default: fallback_url %}
      <a href="{{ col_url }}" class="btn-ghost">
        View All &nbsp;<i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text", "id": "label", "label": "Section label", "default": "New Arrivals" },
    { "type": "text", "id": "title", "label": "Section title", "default": "Freshly Curated Jewelry" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_count", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}
