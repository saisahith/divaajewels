<section class="featured">
  <div class="container">
    <div class="featured-header">
      <span class="section-label">{{ section.settings.label }}</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
      <div class="section-divider"></div>
    </div>

    <div class="products-grid">
      {%- liquid
        assign col = section.settings.collection
        assign featured_collection = collections[col]
        if featured_collection == blank or featured_collection == nil
        assign featured_collection = collections['new-arrivals']
        endif
        assign rendered_products = 0
      -%}

      {%- if featured_collection != blank and featured_collection != nil -%}
        {%- for product in featured_collection.products limit: section.settings.products_count -%}
          {% assign rendered_products = rendered_products | plus: 1 %}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      {%- endif -%}

      {%- if rendered_products == 0 -%}
        {% assign dummy_products = "American Diamond Edit|$125|New|american-diamond,Kundan Edit|$148|Signature|kundan,Temple Jewelry Edit|$110|Heritage|south-indian,Oxidised Jewelry Edit|$45|Best Seller|oxidized,Bridal Necklace Edit|$198|Bridal|bridal-necklace-sets,Silk Saree Edit|$135|Limited|sarees" | split: "," %}
        {% for item in dummy_products %}
          {% assign p = item | split: "|" %}
          <article class="product-card dummy-product-card">
            <a href="{{ routes.collections_url }}/{{ p[3] }}">
              <div class="product-img-wrap product-img-tile" style="background-image:url('{% if forloop.index <= 3 %}{{ 'divaa-jewelry-styles.png' | asset_url }}{% else %}{{ 'divaa-saree-edits.png' | asset_url }}{% endif %}'); background-position:{% cycle '0% 0%', '50% 0%', '100% 0%', '0% 100%', '50% 100%', '100% 100%' %};">
                <span class="product-badge">{{ p[2] }}</span>
              </div>
            </a>
            <div class="product-info">
              <p class="product-brand">Divaa Jewels</p>
              <h3 class="product-name"><a href="{{ routes.collections_url }}/{{ p[3] }}">{{ p[0] }}</a></h3>
              <p class="product-price">{{ p[1] }}</p>
            </div>
          </article>
        {% endfor %}
      {%- endif -%}
    </div>

    <div class="view-all-wrap">
      {%- assign fallback_url = routes.collections_url | append: '/all' -%}
      {%- assign col_url = featured_collection.url | default: fallback_url -%}
      <a href="{{ col_url }}" class="btn-ghost">
        View All &nbsp;<i class="fas fa-arrow-right"></i>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    { "type": "text",       "id": "label",          "label": "Section label",    "default": "New Arrivals" },
    { "type": "text",       "id": "title",          "label": "Section title",    "default": "Freshly Curated Jewelry" },
    { "type": "collection", "id": "collection",     "label": "Collection" },
    { "type": "range",      "id": "products_count", "label": "Products to show", "min": 3, "max": 12, "step": 3, "default": 6 }
  ],
  "presets": [{ "name": "Featured Collection" }]
}
{% endschema %}
