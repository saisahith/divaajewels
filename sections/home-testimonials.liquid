<section class="testimonials">
  <div class="container">
    <div class="testimonials-header">
      <span class="section-label">What Our Customers Say</span>
      <h2 class="section-title">Loved Across the USA</h2>
      <div class="section-divider" style="margin:20px auto 0;"></div>
    </div>
    <div class="testimonials-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card">
          <div class="quote-mark">&ldquo;</div>
          <div class="testimonial-stars">
            {% for i in (1..5) %}&#9733;{% endfor %}
          </div>
          <p class="testimonial-text">{{ block.settings.text }}</p>
          <p class="testimonial-author">— {{ block.settings.author }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "text",   "label": "Review text" },
        { "type": "text",     "id": "author", "label": "Customer name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": {
            "text": "The jewelry I ordered for my sister's wedding was absolutely stunning. Everyone kept asking where I got it from!",
            "author": "Priya M., New Jersey"
          }
        },
        { "type": "testimonial", "settings": {
            "text": "Fast shipping, beautiful packaging, and the quality exceeded my expectations. Will definitely order again!",
            "author": "Ananya R., Texas"
          }
        },
        { "type": "testimonial", "settings": {
            "text": "The oxidized collection is so unique and lightweight. Perfect for everyday wear. Love DiVaa!",
            "author": "Deepa K., California"
          }
        }
      ]
    }
  ]
}
{% endschema %}
