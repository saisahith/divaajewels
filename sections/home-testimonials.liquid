<section class="testimonials">
  <div class="container">
    <div class="testimonials-header">
      <span class="section-label">Customer Reviews</span>
      <h2 class="section-title">Loved by Our Customers</h2>
      <div class="section-divider" style="margin:20px auto 0;"></div>
    </div>
    <div class="testimonials-grid">
      {% for block in section.blocks %}
        <div class="testimonial-card">
          <div class="testimonial-stars" aria-label="5 out of 5 stars">
            {% for i in (1..5) %}&#9733;{% endfor %}
          </div>
          <p class="testimonial-text">{{ block.settings.text }}</p>
          <p class="testimonial-author">{{ block.settings.author }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Testimonials",
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Review text" },
        { "type": "text", "id": "author", "label": "Customer name" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "testimonial", "settings": { "text": "The necklace set looked even better in person. Perfect for my event.", "author": "Priya M., New Jersey" } },
        { "type": "testimonial", "settings": { "text": "Beautiful quality and fast response. Loved the bridal accessories.", "author": "Ananya R., Texas" } },
        { "type": "testimonial", "settings": { "text": "The jewelry paired perfectly with my saree. Very elegant.", "author": "Deepa K., California" } }
      ]
    }
  ]
}
{% endschema %}
