<div class="marquee-section">
  <div class="marquee-track">
    {% assign items = "American Diamond,Kundan,South Indian,Traditional,Oxidized,Necklace Sets,Earrings,Bangles,Sarees,Handcrafted,USA Delivery,Est. 2020" | split: "," %}
    {% for item in items %}{% for i in (1..2) %}
      <span class="marquee-item">
        <span class="dot"></span>
        {{ item }}
      </span>
    {% endfor %}{% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Marquee",
  "settings": [],
  "presets": [{ "name": "Marquee" }]
}
{% endschema %}
