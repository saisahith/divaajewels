<section style="padding:70px 24px 90px; background:#fff; min-height:50vh;">
  <div class="container" style="max-width:800px;">
    <h1 style="font-family:'Cormorant Garamond',serif; font-size:clamp(28px,4vw,48px); font-weight:400; color:var(--dark); margin-bottom:20px;">
      {{ page.title }}
    </h1>
    <div class="section-divider"></div>
    <div style="font-size:14px; line-height:1.9; color:#555;">
      {{ page.content }}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Page",
  "settings": [],
  "presets": [{ "name": "Page" }]
}
{% endschema %}
