{% paginate collection.products by 16 %}

<section style="padding:60px 24px 90px; background:#fff;">
  <div class="container">

    <!-- Collection header -->
    <div class="featured-header" style="text-align:center; margin-bottom:40px;">
      <span class="section-label">{{ collection.title }}</span>
      <h1 class="section-title">{{ collection.description | strip_html | truncate: 80 | default: collection.title }}</h1>
      <div class="section-divider" style="margin:20px auto 0;"></div>
    </div>

    <!-- Category filter links -->
    {% assign style_prefix = '' %}
    {% assign style_title = '' %}
    {% assign style_base_handle = '' %}
    {% if collection.handle == 'american-diamond' or collection.handle contains 'american-diamond-' %}
      {% assign style_prefix = 'american-diamond' %}
      {% assign style_title = 'American Diamond Jewelry' %}
      {% assign style_base_handle = 'american-diamond' %}
    {% elsif collection.handle == 'kundan' or collection.handle contains 'kundan-' %}
      {% assign style_prefix = 'kundan' %}
      {% assign style_title = 'Kundan Jewelry' %}
      {% assign style_base_handle = 'kundan' %}
    {% elsif collection.handle == 'traditional' or collection.handle contains 'traditional-' %}
      {% assign style_prefix = 'traditional' %}
      {% assign style_title = 'Traditional Jewelry' %}
      {% assign style_base_handle = 'traditional' %}
    {% elsif collection.handle == 'south-indian' or collection.handle contains 'south-indian-' %}
      {% assign style_prefix = 'south-indian' %}
      {% assign style_title = 'Temple Jewelry' %}
      {% assign style_base_handle = 'south-indian' %}
    {% elsif collection.handle == 'oxidized' or collection.handle contains 'oxidized-' %}
      {% assign style_prefix = 'oxidized' %}
      {% assign style_title = 'Oxidised Jewelry' %}
      {% assign style_base_handle = 'oxidized' %}
    {% elsif collection.handle == 'bridal-jewelry' or collection.handle contains 'bridal-necklace-sets' or collection.handle contains 'bridal-earrings' or collection.handle contains 'bridal-bangles' or collection.handle contains 'bridal-rings' or collection.handle contains 'bridal-others' %}
      {% assign style_prefix = 'bridal' %}
      {% assign style_title = 'Bridal Jewelry' %}
      {% assign style_base_handle = 'bridal-jewelry' %}
    {% endif %}

    {% if style_prefix != '' %}
      <div class="style-filter-wrap">
        <p class="style-filter-title">Filter {{ style_title }} by type</p>
        <div class="style-filter-grid">
          <a href="{{ routes.collections_url }}/{{ style_base_handle }}"
             class="filter-btn {% if collection.handle == style_base_handle %}active{% endif %}">
            All
          </a>
          {% assign type_handles = "necklace-sets,bridal-necklace-sets,earrings,bangles-bracelets,rings,others" | split: "," %}
          {% assign type_labels = "Necklace Sets,Bridal Necklace Sets,Earrings,Bangles & Bracelets,Rings,Others" | split: "," %}
          {% for type_handle in type_handles %}
            {% assign combined_handle = style_prefix | append: '-' | append: type_handle %}
            <a href="{{ routes.collections_url }}/{{ combined_handle }}"
               class="filter-btn {% if collection.handle == combined_handle %}active{% endif %}">
              {{ type_labels[forloop.index0] }}
            </a>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-bottom:44px;">
        <a href="{{ routes.collections_url }}/all"
           class="filter-btn {% if collection.handle == 'all' %}active{% endif %}">
          All
        </a>
        {% assign cat_handles = "new-arrivals,american-diamond,kundan,traditional,south-indian,oxidized,bridal-jewelry,sarees,bridal-edit,occasion-edit,sale,clearance" | split: "," %}
        {% assign cat_labels  = "New Arrivals,American Diamond,Kundan,Traditional,Temple,Oxidised,Bridal Jewelry,Sarees,Bridal Edit,Occasion Edit,Sale,Clearance" | split: "," %}
        {% for handle in cat_handles %}
          <a href="{{ routes.collections_url }}/{{ handle }}"
             class="filter-btn {% if collection.handle == handle %}active{% endif %}">
            {{ cat_labels[forloop.index0] }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <!-- Sort -->
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:28px; flex-wrap:wrap; gap:12px;">
      <p style="font-size:11px; letter-spacing:1px; color:var(--gray);">
        {{ collection.products_count }} products
      </p>
      <form method="get" action="{{ request.path }}">
        <select name="sort_by" onchange="this.form.submit()"
                style="border:1px solid rgba(0,0,0,.12); padding:8px 12px; font-size:11px; letter-spacing:1px; font-family:'Montserrat',sans-serif; background:#fff; cursor:pointer;">
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
          <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A-Z</option>
        </select>
      </form>
    </div>

    <!-- Products grid -->
    <div class="products-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p style="grid-column:1/-1; text-align:center; color:var(--gray); padding:60px 0; font-size:13px; letter-spacing:1px;">
          No products in this collection yet.
        </p>
      {% endfor %}
    </div>

    <!-- Pagination -->
    {% if paginate.pages > 1 %}
      <div style="display:flex; justify-content:center; gap:8px; margin-top:56px; flex-wrap:wrap;">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="btn-ghost">&larr; Previous</a>
        {% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid rgba(0,0,0,.12);font-size:11px;color:var(--dark);transition:all .3s;">{{ part.title }}</a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;background:var(--gold);color:#fff;font-size:11px;">{{ part.title }}</span>
            {% else %}
              <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;font-size:11px;color:var(--gray);">{{ part.title }}</span>
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="btn-ghost">Next &rarr;</a>
        {% endif %}
      </div>
    {% endif %}

  </div>
</section>

{% endpaginate %}

<style>
  .filter-btn {
    padding: 8px 18px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid rgba(0,0,0,.12);
    color: var(--dark);
    transition: all .3s;
    white-space: nowrap;
  }
  .filter-btn:hover,
  .filter-btn.active {
    background: var(--gold);
    border-color: var(--gold);
    color: #fff;
  }
</style>

{% schema %}
{
  "name": "Collection",
  "settings": [],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
