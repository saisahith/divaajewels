{% paginate collection.products by 16 %}

<section style="padding:60px 24px 90px; background:#fff;">
  <div class="container">
    <div class="featured-header" style="text-align:center; margin-bottom:40px;">
      <span class="section-label">{{ collection.title }}</span>
      <h1 class="section-title">{{ collection.description | strip_html | truncate: 80 | default: collection.title }}</h1>
      <div class="section-divider" style="margin:20px auto 0;"></div>
    </div>

    {% assign filter_title = '' %}
    {% assign base_handle = collection.handle %}
    {% assign filter_handles = '' %}
    {% assign filter_labels = '' %}

    {% if collection.handle == 'necklace-sets' or collection.handle contains 'necklace-sets' %}
      {% assign filter_title = 'Filter Necklace Sets by style' %}
      {% assign base_handle = 'necklace-sets' %}
      {% assign filter_handles = 'american-diamond-necklace-sets,kundan-necklace-sets,temple-necklace-sets,traditional-necklace-sets,oxidized-necklace-sets,bridal-necklace-sets,fusion-contemporary-necklace-sets,premium-necklace-sets' %}
      {% assign filter_labels = 'American Diamond,Kundan,Temple Jewelry,Traditional Jewelry,Oxidized Jewelry,Bridal Necklace Sets,Fusion / Contemporary,Premium Collection' %}
    {% elsif collection.handle == 'earrings' or collection.handle contains 'earrings' %}
      {% assign filter_title = 'Filter Earrings by style' %}
      {% assign base_handle = 'earrings' %}
      {% assign filter_handles = 'american-diamond-earrings,kundan-earrings,temple-earrings,oxidized-earrings' %}
      {% assign filter_labels = 'American Diamond Earrings,Kundan Earrings,Temple Earrings,Oxidized Earrings' %}
    {% elsif collection.handle == 'bangles-bracelets' or collection.handle contains 'bangles' or collection.handle contains 'bracelets' or collection.handle contains 'kadas' %}
      {% assign filter_title = 'Filter Bangles & Bracelets by style' %}
      {% assign base_handle = 'bangles-bracelets' %}
      {% assign filter_handles = 'bangles,kadas,american-diamond-bangles,kundan-bangles,temple-bangles,oxidized-bangles' %}
      {% assign filter_labels = 'Bangles,Kadas,American Diamond Bangles,Kundan Bangles,Temple Bangles,Oxidized Bangles' %}
    {% elsif collection.handle == 'rings' or collection.handle contains 'rings' %}
      {% assign filter_title = 'Filter Rings by style' %}
      {% assign base_handle = 'rings' %}
      {% assign filter_handles = 'american-diamond-rings,kundan-rings' %}
      {% assign filter_labels = 'American Diamond Rings,Kundan Rings' %}
    {% elsif collection.handle == 'bridal-accessories' or collection.handle contains 'maang-tikka' or collection.handle contains 'passa' or collection.handle contains 'matha-patti' or collection.handle contains 'hathphool' or collection.handle contains 'bajuband' or collection.handle contains 'kamarband' %}
      {% assign filter_title = 'Filter Bridal Accessories' %}
      {% assign base_handle = 'bridal-accessories' %}
      {% assign filter_handles = 'maang-tikka,passa,matha-patti,hathphool,bajuband,waist-belt-kamarband' %}
      {% assign filter_labels = 'Maang Tikka,Passa,Matha Patti,Hathphool,Bajuband,Waist Belt / Kamarband' %}
    {% elsif collection.handle == 'sarees' or collection.handle contains 'sarees' %}
      {% assign filter_title = 'Filter Sarees by type' %}
      {% assign base_handle = 'sarees' %}
      {% assign filter_handles = 'banarasi-sarees,kanchivaram-sarees,bridal-sarees,designer-sarees,party-wear-sarees' %}
      {% assign filter_labels = 'Banarasi Sarees,Kanchivaram Sarees,Bridal Sarees,Designer Sarees,Party Wear Sarees' %}
    {% endif %}

    {% if filter_title != '' %}
      <div class="style-filter-wrap">
        <p class="style-filter-title">{{ filter_title }}</p>
        <div class="style-filter-grid">
          <a href="{{ routes.collections_url }}/{{ base_handle }}"
             class="filter-btn {% if collection.handle == base_handle %}active{% endif %}">
            All
          </a>
          {% assign handles = filter_handles | split: ',' %}
          {% assign labels = filter_labels | split: ',' %}
          {% for handle in handles %}
            <a href="{{ routes.collections_url }}/{{ handle }}"
               class="filter-btn {% if collection.handle == handle %}active{% endif %}">
              {{ labels[forloop.index0] }}
            </a>
          {% endfor %}
        </div>
      </div>
    {% else %}
      <div style="display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-bottom:44px;">
        {% assign cat_handles = "new-arrivals,necklace-sets,earrings,bangles-bracelets,rings,bridal-accessories,sarees,bridal-collection,live-sale,clearance" | split: "," %}
        {% assign cat_labels  = "New Arrivals,Necklace Sets,Earrings,Bangles & Bracelets,Rings,Bridal Accessories,Sarees,Bridal Collection,Live Sale,Clearance" | split: "," %}
        {% for handle in cat_handles %}
          <a href="{{ routes.collections_url }}/{{ handle }}"
             class="filter-btn {% if collection.handle == handle %}active{% endif %}">
            {{ cat_labels[forloop.index0] }}
          </a>
        {% endfor %}
      </div>
    {% endif %}

    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:28px; flex-wrap:wrap; gap:12px;">
      <p style="font-size:11px; letter-spacing:1px; color:var(--gray);">
        {{ collection.products_count }} products
      </p>
      <form method="get" action="{{ request.path }}">
        <select name="sort_by" onchange="this.form.submit()"
                style="border:1px solid rgba(0,0,0,.12); padding:8px 12px; font-size:11px; letter-spacing:1px; font-family:'Montserrat',sans-serif; background:#fff; cursor:pointer;">
          <option value="manual" {% if collection.sort_by == 'manual' %}selected{% endif %}>Featured</option>
          <option value="price-ascending" {% if collection.sort_by == 'price-ascending' %}selected{% endif %}>Price: Low to High</option>
          <option value="price-descending" {% if collection.sort_by == 'price-descending' %}selected{% endif %}>Price: High to Low</option>
          <option value="created-descending" {% if collection.sort_by == 'created-descending' %}selected{% endif %}>Newest</option>
          <option value="title-ascending" {% if collection.sort_by == 'title-ascending' %}selected{% endif %}>A-Z</option>
        </select>
      </form>
    </div>

    <div class="products-grid">
      {% for product in collection.products %}
        {% render 'product-card', product: product %}
      {% else %}
        <p style="grid-column:1/-1; text-align:center; color:var(--gray); padding:60px 0; font-size:13px; letter-spacing:1px;">
          No products in this collection yet.
        </p>
      {% endfor %}
    </div>

    {% if paginate.pages > 1 %}
      <div style="display:flex; justify-content:center; gap:8px; margin-top:56px; flex-wrap:wrap;">
        {% if paginate.previous %}
          <a href="{{ paginate.previous.url }}" class="btn-ghost">&larr; Previous</a>
        {% endif %}
        {% for part in paginate.parts %}
          {% if part.is_link %}
            <a href="{{ part.url }}" style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border:1px solid rgba(0,0,0,.12);font-size:11px;color:var(--dark);transition:all .3s;">{{ part.title }}</a>
          {% else %}
            {% if part.title == paginate.current_page %}
              <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;background:var(--gold);color:#fff;font-size:11px;">{{ part.title }}</span>
            {% else %}
              <span style="display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;font-size:11px;color:var(--gray);">{{ part.title }}</span>
            {% endif %}
          {% endif %}
        {% endfor %}
        {% if paginate.next %}
          <a href="{{ paginate.next.url }}" class="btn-ghost">Next &rarr;</a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% endpaginate %}

<style>
  .filter-btn {
    padding: 8px 18px;
    font-size: 10px;
    letter-spacing: 2px;
    text-transform: uppercase;
    border: 1px solid rgba(0,0,0,.12);
    color: var(--dark);
    transition: all .3s;
    white-space: nowrap;
  }
  .filter-btn:hover,
  .filter-btn.active {
    background: var(--gold);
    border-color: var(--gold);
    color: #fff;
  }
</style>

{% schema %}
{
  "name": "Collection",
  "settings": [],
  "presets": [{ "name": "Collection" }]
}
{% endschema %}
