<section class="newsletter">
  <div class="container">
    <h2 class="newsletter-title">{{ section.settings.title }}</h2>
    <p class="newsletter-sub">{{ section.settings.subtitle }}</p>
    <div class="newsletter-form">
      <input type="email" class="newsletter-input" placeholder="{{ section.settings.placeholder }}" aria-label="Email address">
      <button class="newsletter-btn" id="sub-btn">{{ section.settings.button }}</button>
    </div>
    <p style="color:rgba(255,255,255,.6); font-size:10px; letter-spacing:1.5px; margin-top:14px;">
      FREE SHIPPING ON FIRST ORDER OVER $75 · UNSUBSCRIBE ANYTIME
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text",     "id": "title",       "label": "Title",       "default": "Join the DiVaa Family" },
    { "type": "text",     "id": "subtitle",    "label": "Subtitle",    "default": "Subscribe & get 10% off your first order — plus early access to new arrivals" },
    { "type": "text",     "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text",     "id": "button",      "label": "Button text", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
