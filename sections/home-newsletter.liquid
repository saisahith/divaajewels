<section class="newsletter" id="vip-signup">
  <div class="container">
    <h2 class="newsletter-title">{{ section.settings.title }}</h2>
    <p class="newsletter-sub">{{ section.settings.subtitle }}</p>
    <div class="newsletter-form">
      <input type="email" class="newsletter-input" placeholder="{{ section.settings.placeholder }}" aria-label="Email address">
      <button class="newsletter-btn" id="sub-btn">{{ section.settings.button }}</button>
    </div>
    <p class="newsletter-note">
      We respect your inbox. Unsubscribe anytime.
    </p>
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text",     "id": "title",       "label": "Title",       "default": "Join Divaa VIP" },
    { "type": "text",     "id": "subtitle",    "label": "Subtitle",    "default": "Get early access to new arrivals, exclusive offers, and bridal collection updates." },
    { "type": "text",     "id": "placeholder", "label": "Placeholder", "default": "Your email address" },
    { "type": "text",     "id": "button",      "label": "Button text", "default": "Join VIP" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
