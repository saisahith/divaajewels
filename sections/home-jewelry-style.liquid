<section class="categories jewelry-style-section">
  <div class="container">
    <div class="categories-header">
      <span class="section-label">Shop Jewelry</span>
      <h2 class="section-title">Start with what you need.</h2>
    </div>

    <div class="style-type-grid">
      <article class="style-type-card">
        <a href="{{ routes.collections_url }}/necklace-sets" class="style-type-image">
          <div class="category-bg category-img" style="background-image:url('{{ 'divaa-jewelry-types.png' | asset_url }}'); background-position:0% 0%;"></div>
          <h3>Necklace Sets</h3>
        </a>
        <div class="style-type-links">
          <a href="{{ routes.collections_url }}/american-diamond-necklace-sets">American Diamond</a>
          <a href="{{ routes.collections_url }}/kundan-necklace-sets">Kundan</a>
          <a href="{{ routes.collections_url }}/temple-necklace-sets">Temple Jewelry</a>
          <a href="{{ routes.collections_url }}/traditional-necklace-sets">Traditional Jewelry</a>
          <a href="{{ routes.collections_url }}/oxidized-necklace-sets">Oxidized Jewelry</a>
          <a href="{{ routes.collections_url }}/bridal-necklace-sets">Bridal Necklace Sets</a>
        </div>
      </article>

      <article class="style-type-card">
        <a href="{{ routes.collections_url }}/earrings" class="style-type-image">
          <div class="category-bg category-img" style="background-image:url('{{ 'divaa-jewelry-types.png' | asset_url }}'); background-position:100% 0%;"></div>
          <h3>Earrings</h3>
        </a>
        <div class="style-type-links">
          <a href="{{ routes.collections_url }}/american-diamond-earrings">American Diamond Earrings</a>
          <a href="{{ routes.collections_url }}/kundan-earrings">Kundan Earrings</a>
          <a href="{{ routes.collections_url }}/temple-earrings">Temple Earrings</a>
          <a href="{{ routes.collections_url }}/oxidized-earrings">Oxidized Earrings</a>
        </div>
      </article>

      <article class="style-type-card">
        <a href="{{ routes.collections_url }}/bangles-bracelets" class="style-type-image">
          <div class="category-bg category-img" style="background-image:url('{{ 'divaa-jewelry-types.png' | asset_url }}'); background-position:0% 100%;"></div>
          <h3>Bangles & Bracelets</h3>
        </a>
        <div class="style-type-links">
          <a href="{{ routes.collections_url }}/bangles">Bangles</a>
          <a href="{{ routes.collections_url }}/kadas">Kadas</a>
          <a href="{{ routes.collections_url }}/american-diamond-bangles">American Diamond Bangles</a>
          <a href="{{ routes.collections_url }}/kundan-bangles">Kundan Bangles</a>
          <a href="{{ routes.collections_url }}/temple-bangles">Temple Bangles</a>
          <a href="{{ routes.collections_url }}/oxidized-bangles">Oxidized Bangles</a>
        </div>
      </article>

      <article class="style-type-card">
        <a href="{{ routes.collections_url }}/rings" class="style-type-image">
          <div class="category-bg category-img" style="background-image:url('{{ 'divaa-jewelry-types.png' | asset_url }}'); background-position:50% 100%;"></div>
          <h3>Rings</h3>
        </a>
        <div class="style-type-links">
          <a href="{{ routes.collections_url }}/american-diamond-rings">American Diamond Rings</a>
          <a href="{{ routes.collections_url }}/kundan-rings">Kundan Rings</a>
        </div>
      </article>

      <article class="style-type-card">
        <a href="{{ routes.collections_url }}/bridal-accessories" class="style-type-image">
          <div class="category-bg category-img" style="background-image:url('{{ 'divaa-saree-edits.png' | asset_url }}'); background-position:100% 0%;"></div>
          <h3>Bridal Accessories</h3>
        </a>
        <div class="style-type-links">
          <a href="{{ routes.collections_url }}/maang-tikka">Maang Tikka</a>
          <a href="{{ routes.collections_url }}/passa">Passa</a>
          <a href="{{ routes.collections_url }}/matha-patti">Matha Patti</a>
          <a href="{{ routes.collections_url }}/hathphool">Hathphool</a>
          <a href="{{ routes.collections_url }}/bajuband">Bajuband</a>
          <a href="{{ routes.collections_url }}/waist-belt-kamarband">Waist Belt / Kamarband</a>
        </div>
      </article>
    </div>
  </div>
</section>

