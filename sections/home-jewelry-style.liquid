<section class="categories jewelry-style-section" id="jewelry-categories">
  <div class="container">
    <div class="categories-header">
      <span class="section-label">Jewelry Categories</span>
      <h2 class="section-title">Jewelry Categories</h2>
    </div>

    <div class="arrival-collection-grid jewelry-pill-grid" aria-label="Shop jewelry categories">
      {% assign jewelry_cards = "Necklace Sets|Statement necklace sets for weddings, parties, and festive styling.|necklace-sets|0% 0%|divaa-jewelry-types.png||Earrings|Elegant earrings for sarees, lehengas, and everyday ethnic looks.|earrings|100% 0%|divaa-jewelry-types.png||Bangles & Bracelets|Classic bangles and bracelets to complete your celebration look.|bangles-bracelets|0% 100%|divaa-jewelry-types.png||Rings|American Diamond and Kundan rings with a polished occasion finish.|rings|50% 100%|divaa-jewelry-types.png||Bridal Accessories|Maang tikka, matha patti, passa, hathphool, bajuband, and kamarband.|bridal-accessories|100% 0%|divaa-saree-edits.png" | split: "||" %}
      {% for item in jewelry_cards %}
        {% assign card = item | split: "|" %}
        <a href="{{ routes.collections_url }}/{{ card[2] }}" class="arrival-collection-card">
          <span class="arrival-card-image" style="background-image:url('{{ card[4] | asset_url }}'); background-position:{{ card[3] }};"></span>
          <span class="arrival-card-copy">
            <strong>{{ card[0] }}</strong>
            <em>{{ card[1] }}</em>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Jewelry Categories",
  "settings": [],
  "presets": [{ "name": "Jewelry Categories" }]
}
{% endschema %}
