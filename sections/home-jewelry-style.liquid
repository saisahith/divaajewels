<section class="categories jewelry-style-section">
  <div class="container">
    <div class="categories-header">
      <span class="section-label">Shop By Jewelry Style</span>
      <h2 class="section-title">Choose the finish of the moment.</h2>
    </div>

    <div class="categories-grid">
      {% assign cards = "American Diamond Jewelry|american-diamond-jewelry|0% 0%,Kundan Jewelry|kundan-jewelry|50% 0%,Traditional Jewelry|traditional-jewelry|100% 0%,Temple Jewelry|temple-jewelry|0% 100%,Oxidised Jewelry|oxidised-jewelry|50% 100%,Bridal Jewelry|bridal-jewelry|100% 100%" | split: "," %}
      {% for item in cards %}
        {% assign card = item | split: "|" %}
        <a href="{{ routes.collections_url }}/{{ card[1] }}" class="category-card">
          <div class="category-bg category-img" style="background-image:url('{{ 'divaa-jewelry-styles.png' | asset_url }}'); background-position:{{ card[2] }};"></div>
          <div class="category-overlay">
            <h3 class="category-name">{{ card[0] }}</h3>
          </div>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Shop By Jewelry Style",
  "settings": [],
  "presets": [{ "name": "Shop By Jewelry Style" }]
}
{% endschema %}
