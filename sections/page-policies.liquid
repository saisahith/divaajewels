<section style="background:var(--dark);padding:70px 24px 60px;text-align:center;">
  <div class="container">
    <span class="section-label">Transparency First</span>
    <h1 class="section-title" style="color:#fff;">Our Policies</h1>
    <div class="section-divider" style="margin:20px auto 0;"></div>
  </div>
</section>

<!-- Quick nav -->
<div style="background:var(--cream);border-bottom:1px solid rgba(201,168,76,.15);">
  <div class="container" style="max-width:900px;">
    <div style="display:flex;flex-wrap:wrap;gap:0;">
      {% assign pol_links = "Shipping,shipping|Returns,returns|Privacy Policy,privacy|Terms of Service,terms|Refund Policy,refund|FAQ,faq" | split: "|" %}
      {% for item in pol_links %}
        {% assign p = item | split: "," %}
        <a href="#{{ p[1] }}"
           style="padding:16px 24px;font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--dark);border-right:1px solid rgba(0,0,0,.06);transition:color .3s;white-space:nowrap;"
           onmouseover="this.style.color='var(--gold)'" onmouseout="this.style.color='var(--dark)'">
          {{ p[0] }}
        </a>
      {% endfor %}
    </div>
  </div>
</div>

<section style="background:#fff;padding:80px 24px 100px;">
  <div class="container" style="max-width:900px;">

    <!-- Shipping -->
    <div id="shipping" style="margin-bottom:64px;">
      <span class="section-label">Shipping</span>
      <h2 class="section-title">Shipping Policy</h2>
      <div class="section-divider"></div>
      <p style="color:#555;font-size:13px;line-height:1.9;margin-bottom:20px;">
        We ship exclusively within the United States. All orders are processed within 1–3 business days and shipped via USPS or UPS.
      </p>
      <table style="width:100%;border-collapse:collapse;font-size:12px;margin-bottom:20px;">
        <thead>
          <tr style="background:var(--dark);color:#fff;">
            <th style="padding:14px 16px;text-align:left;letter-spacing:1.5px;font-weight:500;">Method</th>
            <th style="padding:14px 16px;text-align:left;letter-spacing:1.5px;font-weight:500;">Cost</th>
            <th style="padding:14px 16px;text-align:left;letter-spacing:1.5px;font-weight:500;">Estimate</th>
          </tr>
        </thead>
        <tbody>
          <tr style="border-bottom:1px solid rgba(0,0,0,.08);">
            <td style="padding:14px 16px;">Standard (USPS / UPS)</td>
            <td style="padding:14px 16px;color:var(--gold);">Free on orders $75+</td>
            <td style="padding:14px 16px;">5–7 business days</td>
          </tr>
          <tr style="border-bottom:1px solid rgba(0,0,0,.08);background:#fafafa;">
            <td style="padding:14px 16px;">Express (USPS Priority)</td>
            <td style="padding:14px 16px;">$9.99</td>
            <td style="padding:14px 16px;">2–3 business days</td>
          </tr>
          <tr style="border-bottom:1px solid rgba(0,0,0,.08);">
            <td style="padding:14px 16px;">Overnight (UPS Next Day)</td>
            <td style="padding:14px 16px;">$24.99</td>
            <td style="padding:14px 16px;">Next business day</td>
          </tr>
        </tbody>
      </table>
      <p style="color:#555;font-size:13px;line-height:1.9;">
        You will receive a tracking number via email once your order ships. Track at <a href="https://tools.usps.com" target="_blank" style="color:var(--gold);">tools.usps.com</a> or via the UPS app.
      </p>
    </div>

    <!-- Returns -->
    <div id="returns" style="margin-bottom:64px;">
      <span class="section-label">Returns</span>
      <h2 class="section-title">Returns & Exchanges</h2>
      <div class="section-divider"></div>
      <p style="color:#555;font-size:13px;line-height:1.9;margin-bottom:14px;">
        We accept returns within <strong>7 days</strong> of delivery for items in original, unworn condition with all packaging intact.
      </p>
      <ul style="color:#555;font-size:13px;line-height:2;padding-left:20px;">
        <li>Contact us on WhatsApp or email within 7 days of receiving your order</li>
        <li>Items must be unused and in original packaging</li>
        <li>Return shipping cost is borne by the customer</li>
        <li>Refunds processed within 5–7 business days of receiving the return</li>
        <li>Custom or personalized orders are non-refundable</li>
      </ul>
    </div>

    <!-- Privacy -->
    <div id="privacy" style="margin-bottom:64px;">
      <span class="section-label">Privacy</span>
      <h2 class="section-title">Privacy Policy</h2>
      <div class="section-divider"></div>
      <p style="color:#555;font-size:13px;line-height:1.9;margin-bottom:14px;">
        DiVaa Jewels N Ensemble is committed to protecting your privacy. We collect your name, email, shipping address, and payment information solely to process and fulfill your orders.
      </p>
      <p style="color:#555;font-size:13px;line-height:1.9;">
        We never sell or share your personal information with third parties except for shipping carriers and payment processors required to fulfill your order. All payments are secured by Stripe and PayPal with 256-bit SSL encryption.
      </p>
    </div>

    <!-- Terms -->
    <div id="terms" style="margin-bottom:64px;">
      <span class="section-label">Terms</span>
      <h2 class="section-title">Terms of Service</h2>
      <div class="section-divider"></div>
      <p style="color:#555;font-size:13px;line-height:1.9;margin-bottom:14px;">
        By placing an order, you agree to our pricing in US Dollars ($), our shipping and return policies, and that all sales are final for custom orders. We accept Visa, Mastercard, American Express, Discover, PayPal, and Venmo (via PayPal).
      </p>
      <p style="color:#555;font-size:13px;line-height:1.9;">
        For Zelle payments, please contact us via WhatsApp before placing your order. DiVaa Jewels reserves the right to cancel any order at its discretion.
      </p>
    </div>

    <!-- Refund -->
    <div id="refund" style="margin-bottom:64px;">
      <span class="section-label">Refunds</span>
      <h2 class="section-title">Refund Policy</h2>
      <div class="section-divider"></div>
      <p style="color:#555;font-size:13px;line-height:1.9;">
        Approved returns are refunded to the original payment method within 5–7 business days. Shipping charges are non-refundable. If you received a damaged or incorrect item, please WhatsApp us with a photo within 48 hours of delivery and we will resolve it immediately at no cost to you.
      </p>
    </div>

    <!-- FAQ -->
    <div id="faq">
      <span class="section-label">FAQ</span>
      <h2 class="section-title">Frequently Asked Questions</h2>
      <div class="section-divider"></div>
      {% assign faqs = "Do you ship outside the USA?,We currently ship exclusively within the United States.|How do I track my order?,You'll receive a tracking number via email once your order ships. You can track it at tools.usps.com or via the UPS app. You can also use our Order Tracking page.|Can I pay via Zelle?,Yes! For Zelle payments, please WhatsApp us at +1 703 389 4519 before placing your order. We'll confirm availability and share our Zelle details.|What if my item arrives damaged?,Please WhatsApp us with photos within 48 hours. We'll replace or refund immediately at no charge to you.|Are the jewellery pieces genuine?,All our pieces are handcrafted by artisans in India using traditional techniques. Product descriptions clearly state the materials used." | split: "|" %}
      {% for faq in faqs %}
        {% assign parts = faq | split: "," %}
        {% assign q = parts[0] %}
        {% assign a = parts[1] %}
        <div style="border-bottom:1px solid rgba(0,0,0,.08);padding:20px 0;">
          <p style="font-size:13px;font-weight:600;color:var(--dark);margin-bottom:10px;letter-spacing:.5px;">{{ q }}</p>
          <p style="font-size:13px;color:#555;line-height:1.8;">{{ a }}</p>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Policies Page",
  "settings": [],
  "presets": [{ "name": "Policies Page" }]
}
{% endschema %}
