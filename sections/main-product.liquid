{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign primary_collection = product.collections.first
  assign tag_string = product.tags | join: ',' | downcase
  assign product_type_downcase = product.type | downcase
  assign is_clothing = false
  if tag_string contains 'saree' or tag_string contains 'lehenga' or tag_string contains 'dress' or tag_string contains 'gown' or product_type_downcase contains 'saree' or product_type_downcase contains 'lehenga' or product_type_downcase contains 'dress' or product_type_downcase contains 'gown'
    assign is_clothing = true
  endif

  assign badge_label = ''
  if product.compare_at_price > product.price
    assign badge_label = 'Sale'
  elsif tag_string contains 'new-arrivals' or tag_string contains 'new arrival' or tag_string contains 'new-arrival'
    assign badge_label = 'New Arrival'
  elsif tag_string contains 'bestseller' or tag_string contains 'best seller'
    assign badge_label = 'Bestseller'
  endif
%}

<section class="product-page product-page-v2" data-product-handle="{{ product.handle }}">
  <div class="container">
    <nav class="product-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ routes.root_url }}">Home</a>
      <span aria-hidden="true">/</span>
      {% if is_clothing %}
        <a href="{{ routes.collections_url }}/clothing">Clothing</a>
        {% if primary_collection != blank %}
          <span aria-hidden="true">/</span>
          <a href="{{ primary_collection.url }}">{{ primary_collection.title }}</a>
        {% endif %}
      {% else %}
        <a href="{{ routes.collections_url }}/jewelry">Jewelry</a>
        {% if primary_collection != blank %}
          <span aria-hidden="true">/</span>
          <a href="{{ primary_collection.url }}">{{ primary_collection.title }}</a>
        {% endif %}
      {% endif %}
      <span aria-hidden="true">/</span>
      <span>{{ product.title }}</span>
    </nav>

    <div class="product-layout product-layout-v2">
      <div class="product-gallery product-gallery-v2" aria-label="{{ product.title | escape }} product images">
        {% if product.images.size > 0 %}
          <div class="product-mobile-carousel" aria-label="{{ product.title | escape }} mobile image carousel">
            {% for image in product.images limit: 8 %}
              <div class="product-mobile-slide">
                <img src="{{ image | image_url: width: 900 }}"
                     alt="{{ image.alt | default: product.title | escape }}"
                     loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                     width="900"
                     height="1125">
              </div>
            {% endfor %}
          </div>
        {% endif %}

        <div class="product-main-media product-main-media-v2">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 1200 }}"
                 alt="{{ product.featured_image.alt | default: product.title | escape }}"
                 id="main-product-img"
                 loading="eager"
                 width="1200"
                 height="1500">
          {% else %}
            <div class="product-placeholder">
              <i class="fas fa-gem"></i>
              <span>{{ product.type | default: 'Jewelry' }}</span>
            </div>
          {% endif %}
        </div>

        {% if product.images.size > 1 %}
          <div class="product-thumbs product-thumbs-v2" aria-label="Product image thumbnails">
            {% for image in product.images limit: 8 %}
              <button type="button" data-full="{{ image | image_url: width: 1200 }}" aria-label="View {{ product.title | escape }} image {{ forloop.index }}">
                <img src="{{ image | image_url: width: 180 }}"
                     alt="{{ image.alt | default: product.title | escape }}"
                     loading="lazy"
                     width="180"
                     height="225">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      </div>

      <aside class="product-summary product-summary-v2" aria-label="Product purchase information">
        <div class="product-status-row">
          {% if badge_label != blank %}
            <span class="product-status-badge">{{ badge_label }}</span>
          {% endif %}
          <span class="product-stock {% unless product.available %}sold-out{% endunless %}">
            {% if product.available %}In Stock{% else %}Sold Out{% endif %}
          </span>
        </div>

        <p class="product-kicker">{{ product.vendor | default: shop.name }}</p>
        <h1>{{ product.title }}</h1>

        <div class="product-review-inline" aria-label="Customer reviews">
          <span aria-hidden="true"><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i></span>
          <em>0 reviews · Be the first to review this piece.</em>
        </div>

        <div class="product-price-row">
          <span>{{ product.price | money }}</span>
          {% if product.compare_at_price > product.price %}
            <s>{{ product.compare_at_price | money }}</s>
          {% endif %}
        </div>

        <p class="product-urgency-note">Popular choice for festive and bridal styling.</p>

        {% form 'product', product, class: 'product-form-v2' %}
          {% if product.has_only_default_variant == false %}
            <div class="product-option">
              <label for="ProductVariant-{{ section.id }}">Select Option</label>
              <select id="ProductVariant-{{ section.id }}" name="id">
                {% for variant in product.variants %}
                  <option value="{{ variant.id }}"
                          {% if variant == selected_variant %}selected{% endif %}
                          {% unless variant.available %}disabled{% endunless %}>
                    {{ variant.title }}{% unless variant.available %} - Sold Out{% endunless %}
                  </option>
                {% endfor %}
              </select>
            </div>
          {% else %}
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
          {% endif %}

          <div class="quantity-row">
            <label for="qty">Quantity</label>
            <div class="quantity-control">
              <button type="button" data-qty-minus aria-label="Decrease quantity">-</button>
              <input type="number" id="qty" name="quantity" value="1" min="1" aria-label="Quantity">
              <button type="button" data-qty-plus aria-label="Increase quantity">+</button>
            </div>
          </div>

          <div class="product-action-row">
            {% if product.available %}
              <button type="submit" name="add" class="btn-primary product-add-btn">
                <i class="fas fa-shopping-bag" aria-hidden="true"></i> Add to Cart
              </button>
              {{ form | payment_button }}
            {% else %}
              <button type="button" disabled class="btn-primary product-add-btn disabled">Sold Out</button>
            {% endif %}
          </div>
        {% endform %}

        <div class="product-trust-badges product-trust-badges-v2" aria-label="Store benefits">
          {% assign trust = "fas fa-truck,Free Shipping on Selected Orders|fas fa-location-dot,Ships from USA|fas fa-headset,Easy Support|fas fa-check-circle,Quality Checked" | split: "|" %}
          {% for item in trust %}
            {% assign parts = item | split: "," %}
            <div>
              <i class="{{ parts[0] }}" aria-hidden="true"></i>
              <span>{{ parts[1] }}</span>
            </div>
          {% endfor %}
        </div>

        <button type="button" class="product-wishlist-btn" aria-label="Add {{ product.title | escape }} to wishlist">
          <i class="far fa-heart" aria-hidden="true"></i>
          Add to Wishlist
        </button>

        <p class="product-support-text">Need styling help? Message us for support before ordering.</p>

      </aside>
    </div>

    <div class="product-details-grid">
      <div class="product-details-card">
        <span class="section-label">Product Details</span>
        <details class="product-accordion" open>
          <summary>Product Description</summary>
          <div>
            {% if product.description != blank %}
              {{ product.description }}
            {% else %}
              <p>Designed for weddings, parties, festive occasions, and elegant ethnic styling, this piece brings a polished finishing touch to your look.</p>
            {% endif %}
          </div>
        </details>

        <details class="product-accordion">
          <summary>What's Included</summary>
          <div>
            {% if tag_string contains 'necklace' or product.title contains 'Necklace' or product.title contains 'Choker' %}
              <p>This listing includes the necklace set pieces shown in the product photos or selected variant. Please review photos and variant options before checkout.</p>
            {% elsif is_clothing %}
              <p>This listing includes the clothing item shown or selected for this product. Jewelry and styling pieces may be shown for inspiration unless explicitly included in the product data.</p>
            {% else %}
              <p>This listing includes the piece or set shown or selected for this product. Please review product photos and variants before checkout.</p>
            {% endif %}
          </div>
        </details>

        <details class="product-accordion">
          <summary>Style Tip</summary>
          <div>
            <p>Pair with complementary ethnic wear in ivory, champagne, maroon, emerald, or soft metallic tones for a polished occasion-ready look.</p>
          </div>
        </details>

        <details class="product-accordion">
          <summary>Care Instructions</summary>
          <div>
            <p>Store in a dry place. Avoid direct contact with water, perfume, and harsh chemicals. Wipe gently after use and store separately.</p>
          </div>
        </details>

        <details class="product-accordion">
          <summary>Shipping & Returns</summary>
          <div>
            <p>Shipping and delivery timelines may vary by location. Contact support for order-specific questions.</p>
          </div>
        </details>
      </div>

      <div class="product-promise-section">
        <span class="section-label">Our Promise</span>
        <h2>Thoughtfully Curated for Every Celebration</h2>
        <div class="promise-grid">
          {% assign promises = "fas fa-gem,Premium Ethnic Styling|fas fa-check,Quality Checked Pieces|fas fa-star,Occasion-Ready Collections|fas fa-lock,Secure Checkout|fas fa-headset,Responsive Customer Support|fas fa-box-open,Carefully Packed Orders" | split: "|" %}
          {% for item in promises %}
            {% assign parts = item | split: "," %}
            <div class="promise-card">
              <i class="{{ parts[0] }}" aria-hidden="true"></i>
              <strong>{{ parts[1] }}</strong>
            </div>
          {% endfor %}
        </div>
      </div>
    </div>

    <section class="product-reviews-section" aria-labelledby="product-reviews-title">
      <div>
        <span class="section-label">Customer Reviews</span>
        <h2 id="product-reviews-title">Reviews</h2>
      </div>
      <div class="reviews-placeholder">
        <div class="review-stars" aria-hidden="true"><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i><i class="far fa-star"></i></div>
        <strong>0 reviews</strong>
        <p>Be the first to review this piece.</p>
        <a href="mailto:{{ shop.email | default: 'support@divaajewels.com' }}?subject=Review%20for%20{{ product.title | url_encode }}" class="btn-outline">Write a Review</a>
      </div>
    </section>

    {% assign related_collection = product.collections.first %}
    <section class="related-products related-products-v2" aria-labelledby="related-products-title">
      <div class="featured-header">
        <span class="section-label">
          {% if related_collection != blank and related_collection.products_count > 1 %}Complete the Look{% else %}People Also Bought{% endif %}
        </span>
        <h2 class="section-title" id="related-products-title">
          {% if related_collection != blank and related_collection.products_count > 1 %}Complete the Look{% else %}People Also Bought{% endif %}
        </h2>
      </div>
      <div class="products-grid">
        {% assign shown_related = 0 %}
        {% if related_collection != blank %}
          {% for related_product in related_collection.products limit: 5 %}
            {% unless related_product.id == product.id %}
              {% assign shown_related = shown_related | plus: 1 %}
              {% render 'product-card', product: related_product %}
            {% endunless %}
            {% if shown_related >= 4 %}
              {% break %}
            {% endif %}
          {% endfor %}
        {% endif %}

        {% if shown_related == 0 %}
          {% assign fallback_collection = collections['new-arrivals'] %}
          {% if fallback_collection != blank %}
            {% for related_product in fallback_collection.products limit: 4 %}
              {% unless related_product.id == product.id %}
                {% assign shown_related = shown_related | plus: 1 %}
                {% render 'product-card', product: related_product %}
              {% endunless %}
            {% endfor %}
          {% endif %}
        {% endif %}

        {% if shown_related == 0 %}
          <p class="empty-collection-message">People Also Bought products will appear here once related products are added.</p>
        {% endif %}
      </div>
    </section>

    <section class="recently-viewed-section" aria-labelledby="recently-viewed-title">
      <div class="featured-header">
        <span class="section-label">Recently Viewed</span>
        <h2 class="section-title" id="recently-viewed-title">Recently Viewed</h2>
      </div>
      <div class="recently-viewed-grid" data-recently-viewed>
        <p class="empty-collection-message">Recently viewed products will appear here as you browse.</p>
      </div>
    </section>
  </div>

  {% if product.available %}
    <div class="mobile-sticky-atc">
      <div>
        <strong>{{ product.title }}</strong>
        <span>{{ product.price | money }}</span>
      </div>
      <button type="button" class="btn-primary" data-mobile-atc> Add to Cart </button>
    </div>
  {% endif %}
</section>

<script type="application/json" id="recent-product-data">
  {
    "handle": {{ product.handle | json }},
    "title": {{ product.title | json }},
    "url": {{ product.url | json }},
    "price": {{ product.price | money | json }},
    "image": {% if product.featured_image %}{{ product.featured_image | image_url: width: 400 | json }}{% else %}null{% endif %}
  }
</script>

{% schema %}
{
  "name": "Product",
  "settings": [],
  "presets": [{ "name": "Product" }]
}
{% endschema %}
