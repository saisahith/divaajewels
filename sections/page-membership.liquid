<section class="membership-page">
  <div class="container">
    <div class="membership-panel">
      <span class="section-label">Membership</span>
      <h1 class="section-title">Join Divaa VIP</h1>
      <p>Join Divaa VIP for early access, private offers, and bridal collection updates.</p>
      <div class="newsletter-form membership-form">
        <input type="email" class="newsletter-input" placeholder="Email address" aria-label="Email address">
        <button class="newsletter-btn" id="membership-sub-btn" type="button">Join VIP</button>
      </div>
      <small>We respect your inbox. Unsubscribe anytime.</small>
    </div>
  </div>
</section>

